{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "date",
    "moscow_time",
    "tier",
    "topic",
    "caption_html",
    "banner",
    "dedup_entries",
    "decision_log",
    "caption_log",
    "sources",
    "approval",
    "blog_eligible"
  ],
  "properties": {
    "status": {
      "enum": ["post", "skip"]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "moscow_time": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}$"
    },
    "tier": {
      "enum": ["freebie", "catalog", "sale", "event", "news", "meme", "skip"]
    },
    "topic": {
      "type": "string",
      "maxLength": 180
    },
    "caption_html": {
      "type": "string",
      "maxLength": 5000
    },
    "banner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rubric", "title", "subtitle", "brand", "items"],
          "properties": {
            "rubric": {
              "enum": ["freebie", "catalog", "sale", "news", "meme"]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 70
            },
            "subtitle": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "brand": {
              "anyOf": [
                {
                  "enum": ["steamgate", "cucumber"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["img", "tag", "old", "new"],
                "properties": {
                  "img": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "tag": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "old": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 30
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "new": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dedup_entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "date", "free_until", "sale_until"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "free_until": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sale_until": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "decision_log": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "^[^\\r\\n]+$"
    },
    "caption_log": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\\r\\n]*$"
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "fact"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["send", "reason", "threads"],
      "properties": {
        "send": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "threads": {
          "type": "boolean"
        }
      }
    },
    "blog_eligible": {
      "type": "boolean"
    }
  }
}
